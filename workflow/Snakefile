from pathlib import Path
import itertools


WORKFLOW = Path("workflow").resolve()
CONFIG = Path("config").resolve()
RESULTS = Path(config.get("results_dir", "/scratch/project/bug_seq_scratch/qc_bench/results_explore_quality")).resolve()
DATA = Path("/scratch/user/s4897040/biox7021/data").resolve()
FIGURES = RESULTS / "figures"
TABLES = RESULTS / "tables"
LOGS = Path("logs/rules").resolve()

RULES = WORKFLOW / "rules"
ENVS = WORKFLOW / "envs"
BENCHMARK = RESULTS / "benchmark"

configfile: CONFIG / "config.yaml"
pepfile: str(CONFIG / "pep/project_config.yaml")
pepschema: str(CONFIG / "pep/pep_schema.yaml")

SAMPLES = pep.sample_table["sample_name"]
DEPTHS = config["depth"]
MODELS = config["model"]
REPEAT = config["repeat"]

# Quality filtering exploration tools (100 bp cutoffs, 1000 bp excluded)
QUALITY_TOOLS = [
	"chopper_extract100",
	"chopper_trim100",
	"fastplong_100",
	"filtlong_default",
	"filtlong_len",
	"filtlong_meanq",
	"seqkit_100",
	"unprocessed"
]

# All settings applied to Dorado-trimmed reads
TRIMMERS = ["dorado"]
EVAL_TRIMMERS = TRIMMERS
EVAL_TOOLS = QUALITY_TOOLS

COMBINATIONS = [f"{tool}-dorado" for tool in QUALITY_TOOLS]

KITS = pep.sample_table["sequencing_kits"]

pr_files = expand(
    RESULTS / "assess/call/{combo}/{depth}x/{model}/{sample}.precision-recall.tsv",
    combo=COMBINATIONS, depth=DEPTHS, sample=SAMPLES, model=MODELS
)

contam_report_files = expand(
    RESULTS / "assess/assembly/contaminant/{combo}/{depth}x/{model}/{sample}.{combo}.contaminants.tsv",
    combo=COMBINATIONS, depth=DEPTHS, sample=SAMPLES, model=MODELS
)

target_files = expand(
    [
        RESULTS / "assess/call/{combo}/{depth}x/{model}/{sample}.precision-recall-summary.tsv",
        RESULTS / "assess/assembly/quast/{combo}/{depth}x/{model}/{sample}.{combo}.report.tsv",
        RESULTS / "assess/assembly/contaminant/{combo}/{depth}x/{model}/{sample}.{combo}.contaminants.tsv",
        RESULTS / "assess/assembly/missed_contigs/{combo}/{depth}x/{model}/{sample}.{combo}.{depth}x.missed_contigs.csv"
    ],
    combo=COMBINATIONS, depth=DEPTHS, sample=SAMPLES, model=MODELS
)

rule all:
	input:
		target_files,
		FIGURES / "param_explore_quality_sup.png",
		FIGURES / "param_explore_quality_hac.png",
		TABLES / "assess/call/metrics/combo_variant_summary.csv",
		TABLES / "assess/assembly/metrics/combo_quast_compiled_metrics.csv",
		TABLES / "assess/assembly/metrics/combo_assembly_missed_contigs.csv",
		TABLES / "assess/assembly/metrics/combo_contaminant_summary_count.csv"

rule plot_param_explore_quality:
	input:
		variant_csv=TABLES / "assess/call/metrics/combo_variant_summary.csv",
		quast_csv=TABLES / "assess/assembly/metrics/combo_quast_compiled_metrics.csv",
		missed_csv=TABLES / "assess/assembly/metrics/combo_assembly_missed_contigs.csv",
		contam_csv=TABLES / "assess/assembly/metrics/combo_contaminant_summary_count.csv"
	log:
		LOGS / "param_explore/param_explore_quality_{model}.log"
	resources:
		mem="16GiB",
		runtime="20m"
	conda:
		ENVS / "generate_figure_python.yaml"
	output:
		figure=FIGURES / "param_explore_quality_{model}.png"
	script:
		"scripts/plot_param_explore_quality.py"

include: RULES / "common.smk"
include: RULES / "trim.smk"
include: RULES / "quality.smk"
include: RULES / "downsample.smk"
include: RULES / "call.smk"
include: RULES / "assembly.smk"
include: RULES / "assess.smk"
include: RULES / "main_figure.smk"
